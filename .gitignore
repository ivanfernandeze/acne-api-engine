__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
dist/
build/

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

.env
.env.local
!.env.example

# Datasets y corridas: no se versionan con Git.
# archive/ es ACNE04 (Wu et al., 2019), un dataset de terceros: se descarga aparte (README).
archive/
data/
runs/
mlruns/
# Chicago Face Database: sus términos prohíben redistribuirla (también a repositorios o servicios en
# la nube) y publicar sus fotos. Fitzpatrick17k: CSV de terceros. Ambos solo para el filtro de acné.
cfd/
cfd.zip
fitzapick17k/
fitzapick17k.zip
# Fitzpatrick17k completo (imágenes de los autores, CC BY-NC-SA 3.0): no se redistribuye.
fitzpatrick17k/
fitzpatrick17k.zip

# Pesos: por defecto fuera de Git (p. ej. yolov8s-cls.pt o weights/, que Ultralytics descarga solo)...
*.pt
*.pth
*.onnx
# ...salvo los que el sistema NECESITA para funcionar tras un clone, versionados con Git LFS
# (.gitattributes): los modelos entrenados de la tesis y el detector facial del cribado.
!checkpoints/*.pt
!app/models/assets/*.onnx

.DS_Store
Thumbs.db
