# =============================================================================
# acne-ai-engine - Motor de inferencia CNN y analisis estadistico
# =============================================================================

AI_PORT=8000
AI_HOST=0.0.0.0
LOG_LEVEL=info

# --- Backend del modelo ------------------------------------------------------
# stub  = clasificador determinista, sin PyTorch. Reporta operational=false en
#         /audit/iia-check, porque la tesis NO puede declarar IIA=1 con un stub.
# torch = EfficientNet-B2 real. Requiere el extra [torch] y un checkpoint valido.
# gemini = LLM multimodal externo. Responde de verdad, pero tampoco es la CNN de la seccion
#          8.1: operational sigue en false y model_kind pasa a llm_externo. Incumple RNF-03
#          (no hay pesos ni semilla que fijen el resultado) y envia la imagen a un tercero.
MODEL_BACKEND=stub
# Familia del checkpoint que sirve el backend torch: timm (EfficientNet-B2, ResNet-50... guardados
# por training/train.py) o yolo_cls (YOLOv8-cls de training/train_yolo_cls.py). El modelo servido
# es el ganador de training/compare.py (F1 macro en el test congelado).
MODEL_ARCH=timm
MODEL_CHECKPOINT_PATH=./checkpoints/efficientnet_b2_iga.pt
# Con MODEL_ARCH=ensemble se ejecutan TODOS los miembros por imagen. ENSEMBLE_RULE decide como se
# forma `prediction`: mas_confiable (por defecto) toma la lectura del miembro con mayor confianza
# (empate -> mayor peso); voto_ponderado promedia las probabilidades ponderando por el peso
# (F1 macro en el test congelado, training/compare.py).
# ENSEMBLE_RULE=mas_confiable
# ENSEMBLE_MEMBERS=yolov8s-cls:yolo_cls:./checkpoints/yolov8s_cls_iga.pt:0.676,efficientnet_b2:timm:./checkpoints/efficientnet_b2_iga.pt:0.633,resnet50:timm:./checkpoints/resnet50_iga.pt:0.627
MODEL_SEED=42
MODEL_INPUT_SIZE=320   # debe coincidir con model.input_size de training/config.yaml y con el checkpoint

# --- Backend gemini (solo si MODEL_BACKEND=gemini) ---------------------------
# La clave va en .env, que esta en .gitignore. NUNCA se escribe aqui su valor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=45

# --- Cribado de admision (POST /image/screen) --------------------------------
# local  = OpenCV YuNet + heuristicas en esta maquina: rechaza lo que no sea la fotografia de un
#          rostro humano (objetos, dibujos a lapiz, imagenes planas, ilustraciones sin color de piel).
#          Ninguna imagen sale del equipo. Limite conocido: una ilustracion coloreada con tono de
#          piel realista puede pasar.
# gemini = delega en el clasificador Gemini si es el backend activo (la imagen viaja a un tercero).
# none   = no se criba; el registro admite cualquier imagen (checked=false).
SCREENING_BACKEND=local

# --- Grad-CAM ----------------------------------------------------------------
ENABLE_GRADCAM=true

# --- Tracking de experimentos ------------------------------------------------
# file | mlflow
TRACKING_DRIVER=file
TRACKING_DIR=./runs
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# --- Datasets (fases 2-5 de CRISP-DM) ---------------------------------------
DATA_DIR=./data
DATASET_VERSION=v1.0
