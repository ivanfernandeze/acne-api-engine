# =============================================================================
# acne-ai-engine — copiar a .env.
# Solo van las variables que hay que definir. Cualquier otra usa el valor por
# defecto de app/config.py.
# =============================================================================

# stub  = simulador determinista, sin PyTorch (reporta operational=false).
# torch = modelos reales entrenados (requiere PyTorch y checkpoints/*.pt).
MODEL_BACKEND=torch

# ensemble = YOLOv8s-cls + EfficientNet-B2 + ResNet-50 sobre cada imagen.
# timm | yolo_cls = un solo modelo (ajustar MODEL_CHECKPOINT_PATH).
MODEL_ARCH=ensemble

# --- Opcionales ---------------------------------------------------------------
# Regla del ensamble: mas_confiable (por defecto) | voto_ponderado
# ENSEMBLE_RULE=mas_confiable
# Cribado de fotos: local (por defecto) | none
# SCREENING_BACKEND=local
# Filtro acné / no acné antes de graduar (activo si existe el checkpoint).
# El umbral, por defecto, es el elegido en validación y guardado en el checkpoint.
# ACNE_GATE_CHECKPOINT=./checkpoints/acne_gate.pt
# ACNE_GATE_THRESHOLD=
# Segunda opinión antes de graduar: none (por defecto) | gemini. Si ve otra condición, la toma no se
# gradúa (ver SECOND_OPINION_STOPS_GRADING); en los demás casos solo advierte.
# Con gemini, cada foto que el filtro deja pasar como acné se envía —reducida a 1024 px, JPEG y sin
# metadatos— a la API de Google. Requiere GEMINI_API_KEY (de pago: el plan gratuito puede usar el
# contenido para entrenar) y que el consentimiento informado lo mencione.
# SECOND_OPINION_BACKEND=none
# SECOND_OPINION_TIMEOUT_SECONDS=20
# Si ve «otra condición» (vitíligo, melasma…), la toma no se gradúa (true, por defecto) o solo se
# advierte (false). Piel sana o acné con otra condición siempre se gradúan, con advertencia.
# SECOND_OPINION_STOPS_GRADING=true
# Modelo de Gemini (por defecto gemini-2.5-flash). La clave va SOLO en .env, nunca aquí.
# GEMINI_MODEL=gemini-2.5-flash
